# Dzeroth backend environment variable reference.
# Copy this file to .env for local development (never commit .env).
# All values here are examples — replace with real values before use.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=dzeroth
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dzeroth
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 bytes. Use a cryptographically random value in production.
JWT_SECRET=change-this-to-a-random-secret-at-least-32-bytes-long

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=8080

# ── Environment ───────────────────────────────────────────────────────────────
# One of: local, test, staging, production
# local and test use corsAllowAll (all origins permitted — development only).
# All other values enforce CORS_ALLOWED_ORIGINS.
ENVIRONMENT=local

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: debug, info, warn, error
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of exact frontend origins allowed to make cross-origin
# requests. Required in non-local/test environments. Leave empty in local/test
# (corsAllowAll is used there regardless of this value).
# If unset or empty in staging/production, all cross-origin requests are blocked
# (no Access-Control-Allow-Origin header is sent) — the server still starts.
# Example: CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
