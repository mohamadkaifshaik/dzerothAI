# Dzeroth — Production environment variable template
#
# Copy this file to deploy/secrets/env.production and fill in all values.
# deploy/secrets/ is in .gitignore — NEVER commit secrets.
#
# All blank values marked REQUIRED must be provided or the API will refuse to start.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=dzeroth
POSTGRES_DB=dzeroth
POSTGRES_PASSWORD=REQUIRED_change_this_strong_password

# Use 'require' for managed PostgreSQL that provides TLS but not CA verification.
# Use 'verify-full' when you have the server certificate and want hostname verification.
# 'disable' is NOT acceptable in production.
POSTGRES_SSL_MODE=require

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REQUIRED_change_this_strong_password

# Set true when using managed Redis with TLS (Redis Cloud, ElastiCache TLS mode, etc).
REDIS_TLS=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
# Must be at least 32 bytes. Rotation requires all existing sessions to re-authenticate.
JWT_SECRET=REQUIRED_generate_with_openssl_rand_base64_48

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=8080

# Admin/observability server. Do NOT publish this port on the public load balancer.
# In production this port is intentionally not published (see docker-compose.prod.yml).
ADMIN_ADDR=:9091

# ── CORS ──────────────────────────────────────────────────────────────────────
# Exact origins the API will accept cross-origin requests from.
# Must match the exact scheme+host+port of your deployed Flutter web app or CDN origin.
# Multiple origins are comma-separated.
# Example: CORS_ALLOWED_ORIGINS=https://app.dzeroth.com
CORS_ALLOWED_ORIGINS=REQUIRED_https://your-frontend-domain.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Session cleanup ───────────────────────────────────────────────────────────
# How often the background worker removes expired session rows from PostgreSQL.
SESSION_CLEANUP_INTERVAL=1h
