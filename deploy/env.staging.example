# Dzeroth — Staging environment variable template
#
# Copy this file to deploy/secrets/env.staging and fill in all values.
# deploy/secrets/ is in .gitignore — NEVER commit secrets.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=dzeroth
POSTGRES_DB=dzeroth_staging
POSTGRES_PASSWORD=REQUIRED_staging_password

# 'require' is acceptable for staging. Use 'disable' only if your staging host
# has no network path risk (e.g. loopback only) — not recommended.
POSTGRES_SSL_MODE=require

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REQUIRED_staging_redis_password
REDIS_TLS=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# A separate secret from production — staging tokens must not be valid on production.
# Generate with: openssl rand -base64 48
JWT_SECRET=REQUIRED_staging_jwt_secret_different_from_production

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=8080
ADMIN_ADDR=:9091

# ── CORS ──────────────────────────────────────────────────────────────────────
# Staging frontend origin. Must be the exact scheme+host of the staging app.
# Example: CORS_ALLOWED_ORIGINS=https://staging.dzeroth.com
CORS_ALLOWED_ORIGINS=REQUIRED_https://staging.your-domain.com

# ── Logging ───────────────────────────────────────────────────────────────────
# debug is recommended for staging to aid integration testing.
LOG_LEVEL=debug

# ── Session cleanup ───────────────────────────────────────────────────────────
SESSION_CLEANUP_INTERVAL=30m
