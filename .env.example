# ---------------------------------------------------------------------------
# Dzeroth — environment variable reference
#
# Copy this file to .env and fill in real values for local development.
# Never commit .env to version control.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PostgreSQL (also consumed by docker-compose.yml to initialize the container)
# ---------------------------------------------------------------------------

# Name of the PostgreSQL database
POSTGRES_DB=dzeroth

# PostgreSQL role used by the application
POSTGRES_USER=dzeroth

# Password for POSTGRES_USER
POSTGRES_PASSWORD=changeme

# Hostname or IP of the PostgreSQL server
POSTGRES_HOST=localhost

# TCP port PostgreSQL listens on
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Address of the Redis server in host:port form.
# Used for rate-limit counters and leaderboard ZSETs.
# Auth/rate-limit endpoints FAIL CLOSED (503) when Redis is unavailable.
REDIS_ADDR=localhost:6379

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# HS256 signing secret for JWT access tokens.
# Must be at least 32 bytes of high-entropy random data.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-bytes-of-random-data

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# TCP port the API server binds to
API_PORT=8080

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Deployment environment. Affects logging format and certain safety checks.
# Allowed values: local | test | staging | production
ENVIRONMENT=local

# Minimum log level emitted by the zap logger.
# Allowed values: debug | info | warn | error
LOG_LEVEL=debug
