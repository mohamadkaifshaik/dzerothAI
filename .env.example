# ---------------------------------------------------------------------------
# Dzeroth — root local development environment
#
# Copy this file to .env for local development. Never commit .env.
# All values below are placeholders — replace them with local-only values.
#
# Consumed by:
#   - docker-compose.yml (postgres service: env_file + ${VAR} interpolation)
#   - the Go backend when run on the host (see apps/backend/.env.example for
#     the complete backend reference)
#
# No AWS variables belong here: the application reads none. Production
# backups authenticate through the EC2 IAM role (IMDSv2), not env vars.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# PostgreSQL (initializes the local docker-compose postgres container)
# ---------------------------------------------------------------------------

POSTGRES_DB=dzeroth
POSTGRES_USER=dzeroth
POSTGRES_PASSWORD=<local-development-password>

# ---------------------------------------------------------------------------
# Host-run Go backend
# ---------------------------------------------------------------------------

# The backend runs on the host and reaches the compose services via localhost.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local Redis (docker-compose.yml) is intentionally password-less, so
# REDIS_PASSWORD is not set here. Auth/rate-limit endpoints fail closed (503)
# when Redis is unavailable.
REDIS_ADDR=localhost:6379

# HS256 signing secret for JWT access tokens — at least 32 bytes.
# Generate a local value with: openssl rand -hex 32
JWT_SECRET=<local-development-secret-at-least-32-bytes>

# TCP port the API server binds to
API_PORT=8080

# Allowed values: local | test | staging | production
ENVIRONMENT=local

# Allowed values: debug | info | warn | error
LOG_LEVEL=debug
